# ============================================================
# Variables de entorno — AgroGestion / AgroCloud
# ============================================================
# Copiar a .env y completar valores. NUNCA subir .env al repositorio.
# Docker Compose lee este archivo para sustituir ${VARIABLES} en docker-compose.yml.

# Perfil de Spring (producción / Docker: prod)
SPRING_PROFILES_ACTIVE=prod

# Flyway: true en VPS con BD vacía. false tras restore de Railway hasta validar historial.
SPRING_FLYWAY_ENABLED=true

# Imágenes publicadas en GHCR (vacío = build local con docker compose --build)
# IMAGEN_BACKEND=ghcr.io/TU_ORG/agrogestion-backend:latest
# IMAGEN_FRONTEND=ghcr.io/TU_ORG/agrogestion-frontend:latest
IMAGEN_BACKEND=
IMAGEN_FRONTEND=

# Login a GHCR en el VPS (opcional; también podés docker login a mano)
# GHCR_USUARIO=
# GHCR_TOKEN=

# Zona horaria del contenedor backend (Hibernate persiste en UTC)
TZ=America/Argentina/Buenos_Aires

# Puerto HTTP del backend
PORT=8080

# ------------------------------------------------------------
# Base de datos
# ------------------------------------------------------------
# DATABASE_URL en .env aplica al backend ejecutado en el host (iniciar-proyecto.bat).
# En Docker Compose el backend usa siempre jdbc:mysql://mysql:3306/<MYSQL_DATABASE>
# (nombre del servicio), no hace falta rellenar DATABASE_URL para compose.
DATABASE_URL=
MYSQL_DATABASE=agroclouddb
MYSQL_ROOT_PASSWORD=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# JWT — obligatorio con perfil prod (mínimo 32 caracteres, HS256)
JWT_SECRET=

# Cifrado claves API Gemini (chat IA). Obligatorio en perfil prod; mínimo 32 caracteres.
CHAT_IA_ENCRYPTION_KEY=

# Chat IA Gemini — clave de proyecto (opcional). Nunca commitear el valor.
IA_GEMINI_API_KEY=
IA_GEMINI_HABILITADO=true
IA_GEMINI_MODEL=gemini-flash-latest

# OpenWeatherMap (clima). Opcional; sin valor, esos endpoints fallan con mensaje claro.
OPENWEATHER_API_KEY=

# Puertos en el PC (compose local). 3306 y 3000 suelen estar ocupados por MySQL/npm.
PUERTO_MYSQL_HOST=3307
PUERTO_BACKEND_HOST=8080
PUERTO_FRONTEND_HOST=3001

# CORS — orígenes del frontend, separados por coma (sin espacios)
CORS_ALLOWED_ORIGINS=http://localhost:3001

# URL pública del frontend (emails, reset password, CORS auxiliar)
FRONTEND_URL=http://localhost:3001

# SMTP (opcional; vacío = la aplicación arranca sin correo)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ------------------------------------------------------------
# VPS / Caddy (solo docker-compose.prod.yml)
# ------------------------------------------------------------
DOMINIO=
CADDY_EMAIL=

# ------------------------------------------------------------
# Frontend (Vite). Se embeben en el JS en tiempo de BUILD de la imagen.
# Docker (nginx o Caddy, mismo origen): /api
# npm run dev (sin Docker): http://localhost:8080/api
# No uses la URL de Railway. Cambiar esto exige reconstruir el frontend.
# ------------------------------------------------------------
VITE_API_BASE_URL=/api

# Solo Docker local (nunca en VPS). docker-compose.yml ya lo activa por defecto.
# Dejar false en copias de .env destinadas al VPS.
APP_CREAR_USUARIO_LOCAL=false
APP_USUARIO_LOCAL_EMAIL=admin@localhost
APP_USUARIO_LOCAL_PASSWORD=AgrocloudLocal1
# Clave de navegador. Restringir en Google Cloud Console: HTTP referrers + APIs de Maps.
VITE_GOOGLE_MAPS_API_KEY=
# Secret de la API key (solo servidor; no exponer al frontend ni a la imagen del frontend)
GOOGLE_MAPS_API_KEY_SECRET=

# Perfil railway-mysql (solo si usas ese perfil fuera de Docker)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=
