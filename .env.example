# ============================================================
# Variables de entorno para AgroGestion / AgroCloud Backend
# ============================================================
# Copiar a .env y completar valores. NUNCA subir .env al repositorio.
# En cloud (Render/Railway/Fly.io) definir estas variables en el panel.

# Perfil de Spring (en producción usar: prod)
SPRING_PROFILES_ACTIVE=prod

# Puerto HTTP (Render/Railway/Fly.io suelen inyectar PORT automáticamente)
PORT=8080

# Base de datos
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# OpenWeatherMap (clima real en WeatherService). Opcional en dev; obligatorio si se usa ese flujo en prod.
OPENWEATHER_API_KEY=

# CORS - Orígenes permitidos (URL del frontend, separados por coma si hay varios)
CORS_ALLOWED_ORIGINS=

# URL pública del frontend (emails, reset password, etc.)
FRONTEND_URL=

# SMTP (opcional si no usas envío de correo)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Perfil railway-mysql (solo si usas ese perfil)
# SPRING_DATASOURCE_URL=
# SPRING_DATASOURCE_USERNAME=
# SPRING_DATASOURCE_PASSWORD=

# Perfil railway-h2 (solo para H2 en memoria)
# DB_USERNAME=sa
# DB_PASSWORD=
