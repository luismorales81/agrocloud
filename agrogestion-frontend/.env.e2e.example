# Variables para tests e2e Playwright (copiar a .env.e2e.local, no commitear)

# URL del frontend (Vite dev o preview)
E2E_BASE_URL=http://localhost:3000

# Credenciales de usuario de prueba con acceso a empresa y módulo cultivos
# Ejemplo local: usuario demo de desarrollo
E2E_EMAIL=
E2E_PASSWORD=

# Si el frontend ya está corriendo, evitar que Playwright levante otro servidor
# E2E_SKIP_WEB_SERVER=true
